# Application
APP_NAME=coderev-ai
APP_ENV=development
SECRET_KEY=your-super-secret-key-change-in-production
DEBUG=true

# Database
POSTGRES_USER=coderev
POSTGRES_PASSWORD=coderev_secret
POSTGRES_DB=coderev_ai
DATABASE_URL=postgresql+asyncpg://coderev:coderev_secret@localhost:5432/coderev_ai
SYNC_DATABASE_URL=postgresql://coderev:coderev_secret@localhost:5432/coderev_ai

# Redis
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# GitHub OAuth
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret
GITHUB_REDIRECT_URI=http://localhost:8000/auth/github/callback
GITHUB_WEBHOOK_SECRET=your-webhook-secret

# Anthropic
ANTHROPIC_API_KEY=your-anthropic-api-key

# JWT
JWT_SECRET_KEY=your-jwt-secret-key-change-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080

# Frontend
FRONTEND_URL=http://localhost:3000
VITE_API_URL=http://localhost:8000

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
